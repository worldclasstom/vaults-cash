# ---- public (baked into the browser bundle at build time) ----
# Privy app (dashboard.privy.io): embedded wallets + smart wallets (Kernel);
# Base with the CDP bundler + paymaster, Robinhood Chain as a custom chain
# on the Alchemy bundler.
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id
# Where the platform fee is sent. Published on /trust.
NEXT_PUBLIC_FEE_RECIPIENT=0x0000000000000000000000000000000000000000
# 60 bps = 0.6%. Split 50/50 on-chain with the referrer's wallet when there is one.
NEXT_PUBLIC_FEE_BPS=60
# "1" once the Base paymaster sponsors gas (only changes copy).
NEXT_PUBLIC_GAS_SPONSORED=
# Alchemy ERC-20 Payments policy id (Robinhood Chain): users pay gas in USDG, no ETH needed.
# Also paste it as the gas policy id in Privy's Robinhood chain entry.
NEXT_PUBLIC_GAS_TOKEN_POLICY_4663=
# Public repo URL shown on /trust; leave unset to hide the line.
NEXT_PUBLIC_SOURCE_URL=

# ---- server only ----
# Lets /api/referral/me verify a claimed wallet belongs to the signed-in
# Privy user (Privy dashboard -> App settings -> Basics -> App secret).
PRIVY_APP_SECRET=
# Server-side RPC + NFT indexer. Optional locally; public RPCs cover reads.
ALCHEMY_API_KEY=
# Optional explicit overrides for the server RPC per chain.
BASE_RPC_URL=
ROBINHOOD_RPC_URL=
# Neon Postgres for the referral ledger and agent keys (Vercel integration injects this).
DATABASE_URL=

# ---- account-linked agent access (optional; the Account card hides until set) ----
# Key quorum id registered in Privy → Authorization keys (the PUBLIC key of the
# pair below). Users grant this signer on their embedded wallet.
NEXT_PUBLIC_PRIVY_SIGNER_ID=
# Optional Privy policy id restricting what the signer may do (recommended:
# allow only Permit2, the Uniswap router / position manager, USDC and USDG).
NEXT_PUBLIC_PRIVY_SIGNER_POLICY_ID=
# The matching PRIVATE key (base64 PKCS8), server only. Never in the browser.
PRIVY_AUTHORIZATION_PRIVATE_KEY=
# ERC-4337 bundler URLs the server sends user operations to — the same ones
# the Privy dashboard uses for the app. Base: CDP bundler+paymaster URL
# (sponsors gas). Robinhood: defaults to the Alchemy bundler from ALCHEMY_API_KEY.
BUNDLER_URL_8453=
BUNDLER_URL_4663=
