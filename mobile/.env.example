# Copy to .env (gitignored). Everything here ships in the app binary: public values only.
EXPO_PUBLIC_PRIVY_APP_ID=
# Privy dashboard → App settings → Clients → add a client for bundle id cash.vaults.app
EXPO_PUBLIC_PRIVY_CLIENT_ID=
# Same values as the web app's NEXT_PUBLIC_* (the shared lib reads them through src/lib/config.ts)
EXPO_PUBLIC_FEE_RECIPIENT=
EXPO_PUBLIC_FEE_BPS=60
EXPO_PUBLIC_GAS_TOKEN_POLICY_4663=
EXPO_PUBLIC_LADDER_CLOSER_8453=
EXPO_PUBLIC_LADDER_CLOSER_4663=
EXPO_PUBLIC_TARGETS_LIVE=
# Read-only RPC the app talks to directly (no browser CORS rules on a phone). Public endpoints by default.
EXPO_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
EXPO_PUBLIC_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# The web app, for stats and the account-linked routes
EXPO_PUBLIC_API_ORIGIN=https://vaults.cash
